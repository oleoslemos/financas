VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Opcional: só estes e-mails acessam o app após login (vírgula ou ;). Combine com restrição no Clerk.
# VITE_ALLOWED_EMAILS=leoslemos@gmail.com,suelenjalves@gmail.com

# Opcional: força um único "dono de dados" para workspace compartilhado.
# Todos os usuários passam a operar os registros desse user_id.
# Ex.: VITE_SHARED_DATA_OWNER_ID=user_2abcDEF...
# VITE_SHARED_DATA_OWNER_ID=
#
# Quando VITE_SHARED_DATA_OWNER_ID está definido, liste aqui os e-mails (vírgula ou ;) que devem
# usar esse dono (ex.: casal). Outros usuários continuam com o próprio user_id.
# VITE_SHARED_EMAILS=leoslemos@gmail.com,suelenjalves@gmail.com
#
# No Supabase, use as migrations de RLS de workspace compartilhado (ver
# supabase/migrations/20260407110000_shared_workspace_policies.sql e
# 20260422160000_ensure_finance_shared_workspace_rls.sql), senão o segundo usuário não vê
# categorias / movimentos do dono e inserts falham com erro de RLS.

# Sync de tarefas (script local npm run sync:tasks)
# SYNC_OWNER_USER_ID=user_2abcDEF...
# SUPABASE_SERVICE_ROLE_KEY=
# GOOGLE_TASKLIST_ID=
# GOOGLE_CALENDAR_ID=primary
# Para puxar todos os calendários visíveis da conta: GOOGLE_CALENDAR_ID=*

# Google OAuth (server-side) para sync sem CLI
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# Se GOOGLE_OAUTH_CLIENT_ID/SECRET nao forem definidos, o sync usa fallback:
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (mesmo client do NextAuth).
# NextAuth Google Provider (Bemaviv + Google Calendar)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
# OAuth direto (sem NextAuth) para gravar refresh_token no Supabase:
# usa GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET por padrao
# Importar tarefas soltas da lista Google para o sistema (opcional; padrao desligado)
# GOOGLE_TASKS_AUTO_IMPORT=false

# Multi-conta (recomendado): credenciais por usuário ficam na tabela
# public.google_user_sync_credentials (refresh_token, tasklist_id, calendar_id).
# Nesse modo, GOOGLE_OAUTH_REFRESH_TOKEN / GOOGLE_TASKLIST_ID / GOOGLE_CALENDAR_ID
# servem apenas como fallback.

# Lark OAuth app (server-side) para sync sem CLI
# LARK_APP_ID=
# LARK_APP_SECRET=

# Opcional (frontend): endpoint HTTP para disparar sync ao clicar em "SINCRONIZAR AGORA" na Agenda.
# Ex.: VITE_SYNC_TASKS_WEBHOOK_URL=https://seu-endpoint/sync-tasks
# VITE_SYNC_TASKS_WEBHOOK_URL=
# O botão da Agenda usa Authorization Bearer com sessão Clerk; não precisa token VITE público.
#
# Opcional (backend API): token técnico validado em /api/sync-tasks
# Use para cron/chamadas de serviço que não passam pelo login do Clerk.
# SYNC_WEBHOOK_TOKEN=
